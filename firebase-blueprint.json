{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID matching auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last login"
        }
      },
      "required": ["id", "email"]
    },
    "Experiment": {
      "title": "Experiment",
      "description": "User saved cognitive and physical science simulation experiments",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique experiment ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "module": {
          "type": "string",
          "description": "Module type: silicon, logic, turing, sparks, alphafold, neuromorphic"
        },
        "title": {
          "type": "string",
          "description": "Experiment title",
          "maxLength": 128
        },
        "parameters": {
          "type": "string",
          "description": "JSON string of experimental inputs and parameters",
          "maxLength": 10000
        },
        "results": {
          "type": "string",
          "description": "JSON string or text notes of observed outcomes",
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update timestamp"
        }
      },
      "required": ["id", "userId", "module", "title"]
    },
    "ResearchBlueprint": {
      "title": "ResearchBlueprint",
      "description": "Exportable research notes and architectural blueprints",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique blueprint ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "description": "Blueprint title",
          "maxLength": 128
        },
        "content": {
          "type": "string",
          "description": "Markdown content of the blueprint",
          "maxLength": 50000
        },
        "syncedToDrive": {
          "type": "boolean",
          "description": "Whether synced to Google Drive"
        },
        "driveFileId": {
          "type": "string",
          "description": "Google Drive file ID if synced"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update timestamp"
        }
      },
      "required": ["id", "userId", "title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile documents"
    },
    "/users/{userId}/experiments/{experimentId}": {
      "schema": "Experiment",
      "description": "User experiments and simulation results"
    },
    "/users/{userId}/blueprints/{blueprintId}": {
      "schema": "ResearchBlueprint",
      "description": "User research blueprints and notes"
    }
  }
}
